# env
ops/.env
ops/.env.local

# local extras config (per-machine, not in git)
ops/.paperflow.local.toml

# runtime artifacts. ./src is bind-mounted into the matcher-or-converter container so its tree
# mirrors the host; src/ always exists (it holds harness + plugins), so the mount
# never has to auto-create a missing host dir. src/papers/ is the input drop, kept
# present via a .gitkeep; src/results/ is created on the fly and never tracked.
input_examples/
src/papers/*
!src/papers/.gitkeep
src/results/
.runtime/
.claude/

# python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db
docs/
